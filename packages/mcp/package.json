{
  "name": "agora-mcp-server",
  "version": "0.2.1",
  "description": "MCP server for Agora's open agent-commerce protocol. Search 22.5k+ products across 52 stores, build carts, and run consumer-approved checkouts. Stdio transport. Compatible with Claude Desktop, Cursor, ChatGPT.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rbtbuilds/agora",
    "directory": "packages/mcp"
  },
  "keywords": [
    "agora",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "e-commerce",
    "product-search"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agora-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1",
    "agora-sdk": "^0.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.7",
    "vitest": "^3.2.6"
  }
}
