DATABASE_URL=postgresql://user:pass@localhost:5432/agora
OPENAI_API_KEY=sk-...
AGORA_API_URL=http://localhost:3000

# Public-facing URLs surfaced in OpenAPI spec, /.well-known/agora.json,
# adapter manifests, and the portal's CSP. Defaults to the Vercel auto-generated
# hostnames if unset — set these explicitly once custom domains are live.
AGORA_PUBLIC_URL=https://agora-ecru-chi.vercel.app
AGORA_PORTAL_URL=https://agora-portal.vercel.app

# Upstash Redis -- backs the auth-failure limiter and the daily tier quota
# (packages/api/src/lib/rate-limit.ts). If unset, the API falls back to an
# in-memory limiter + a read-only DB usage count (per-instance, not shared),
# so these are optional locally but required for correct limiting in production.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# Demo shopping chat (packages/demo). Vercel deployments authenticate to AI
# Gateway with OIDC; local runs can use an AI Gateway API key instead.
AI_GATEWAY_API_KEY=
AGORA_API_KEY=ak_test_your-demo-key

# The demo requires shared Redis storage to enforce five messages per IP per
# UTC day. Vercel's Upstash integration supplies these KV_* variables.
KV_REST_API_URL=https://your-demo-db.upstash.io
KV_REST_API_TOKEN=your-demo-rest-token
